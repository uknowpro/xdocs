  "sources": [
    {
      "name": "gcp-regional-shared-egress.tf.json",
      "content": "{\n  \"terraform\": {\n    \"required_providers\": {\n      \"google\": {\n        \"source\": \"hashicorp/google\",\n        \"version\": \"~> 6.0\"\n      }\n    }\n  },\n  \"variable\": {\n    \"host_project\": {\n      \"type\": \"string\"\n    },\n    \"service_project\": {\n      \"type\": \"string\"\n    }\n  },\n  \"provider\": {\n    \"google\": {\n      \"project\": \"${var.host_project}\",\n      \"region\": \"asia-northeast3\"\n    }\n  },\n  \"resource\": {\n    \"google_compute_shared_vpc_host_project\": {\n      \"host\": {\n        \"project\": \"${var.host_project}\"\n      }\n    },\n    \"google_compute_shared_vpc_service_project\": {\n      \"orders\": {\n        \"host_project\": \"${google_compute_shared_vpc_host_project.host.project}\",\n        \"service_project\": \"${var.service_project}\"\n      }\n    },\n    \"google_compute_network\": {\n      \"fabric\": {\n        \"name\": \"regional-fabric\",\n        \"auto_create_subnetworks\": false\n      }\n    },\n    \"google_compute_subnetwork\": {\n      \"seoul\": {\n        \"name\": \"seoul-workloads\",\n        \"region\": \"asia-northeast3\",\n        \"ip_cidr_range\": \"10.71.0.0/20\",\n        \"network\": \"${google_compute_network.fabric.id}\",\n        \"private_ip_google_access\": true\n      },\n      \"tokyo\": {\n        \"name\": \"tokyo-workloads\",\n        \"region\": \"asia-northeast1\",\n        \"ip_cidr_range\": \"10.72.0.0/20\",\n        \"network\": \"${google_compute_network.fabric.id}\",\n        \"private_ip_google_access\": true\n      }\n    },\n    \"google_compute_router\": {\n      \"seoul\": {\n        \"name\": \"seoul-router\",\n        \"region\": \"asia-northeast3\",\n        \"network\": \"${google_compute_network.fabric.id}\"\n      },\n      \"tokyo\": {\n        \"name\": \"tokyo-router\",\n        \"region\": \"asia-northeast1\",\n        \"network\": \"${google_compute_network.fabric.id}\"\n      }\n    },\n    \"google_compute_router_nat\": {\n      \"seoul\": {\n        \"name\": \"seoul-nat\",\n        \"region\": \"asia-northeast3\",\n        \"router\": \"${google_compute_router.seoul.name}\",\n        \"nat_ip_allocate_option\": \"AUTO_ONLY\",\n        \"source_subnetwork_ip_ranges_to_nat\": \"LIST_OF_SUBNETWORKS\",\n        \"subnetwork\": [\n          {\n            \"name\": \"${google_compute_subnetwork.seoul.id}\",\n            \"source_ip_ranges_to_nat\": [\n              \"ALL_IP_RANGES\"\n            ]\n          }\n        ]\n      },\n      \"tokyo\": {\n        \"name\": \"tokyo-nat\",\n        \"region\": \"asia-northeast1\",\n        \"router\": \"${google_compute_router.tokyo.name}\",\n        \"nat_ip_allocate_option\": \"AUTO_ONLY\",\n        \"source_subnetwork_ip_ranges_to_nat\": \"LIST_OF_SUBNETWORKS\",\n        \"subnetwork\": [\n          {\n            \"name\": \"${google_compute_subnetwork.tokyo.id}\",\n            \"source_ip_ranges_to_nat\": [\n              \"ALL_IP_RANGES\"\n            ]\n          }\n        ]\n      }\n    }\n  }\n}\n"
    }
  ],
