{
  "name": "xdocs",
  "version": "0.5.6",
  "private": true,
  "description": "Local-first connected notes for desktop",
  "author": "uknowpro",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:desktop": "node tests/electron-smoke.mjs",
    "format": "prettier --write src desktop server tests docs *.json *.ts *.html README.md CHANGELOG.md .github/workflows",
    "server": "node --env-file-if-exists=server/.env server/main.mjs",
    "server:grant": "node --env-file-if-exists=server/.env server/grant.mjs",
    "test:server": "node tests/server-integration.mjs",
    "test:sso": "node tests/sso-integration.mjs",
    "test:features": "node tests/electron-features.mjs",
    "test:benchmark": "node tests/vault-benchmark.mjs",
    "test:sheets": "node tests/electron-sheets.mjs",
    "test:soak": "node tests/collaboration-soak.mjs",
    "test:infrastructure": "node tests/electron-infrastructure.mjs",
    "test:architecture": "node tests/electron-architecture.mjs",
    "test:architecture:fixtures": "node tests/architecture-fixtures.mjs",
    "prestart": "node scripts/prepare-analyzers.mjs",
    "test:analyzer": "node tests/electron-analyzer.mjs",
    "test:xcode": "node tests/electron-xcode.mjs"
  },
  "dependencies": {
    "@cdktn/hcl2json": "^0.25.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.17",
    "marked": "^17.0.0",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.5",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.0",
    "diff": "^8.0.4",
    "dompurify": "^3.3.0",
    "electron": "45.3.3",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "io.uknowpro.xdocs",
    "productName": "xdocs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "shared/**/*",
      "package.json",
      "!node_modules/exceljs/dist{,/**/*}",
      "!node_modules/{pg,pg-*,pgpass,postgres-*,redis,@redis/*}{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.xdocs.txt"
      },
      {
        "from": "LICENSE.previous-MIT",
        "to": "LICENSE.previous-MIT"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "uknowpro <yunho0520@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "uknowpro",
      "repo": "xdocs"
    },
    "asarUnpack": [
      "desktop/excel-import.ps1"
    ],
    "afterPack": "scripts/package-analyzers.cjs"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
